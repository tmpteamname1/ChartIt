# Copy to .env (cp .env.example .env). The .env file is not committed.
# Used by docker-compose.yml and by Django when run from the venv.

# PostgreSQL in Docker (docker compose up db)
POSTGRES_DB=chartit
POSTGRES_USER=chartit
POSTGRES_PASSWORD=chartit

# Django connection to the database. From the venv the database is on localhost;
# inside Docker, docker-compose.yml overrides the host to "db".
DATABASE_URL=postgres://chartit:chartit@localhost:5432/chartit

# Local development only. Production sets these on the platform (DEBUG=False).
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
