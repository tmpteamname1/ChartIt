# Copy to .env (cp .env.example .env). The .env file is not committed.
# Used by docker-compose.yml and by Django when run from the venv.
# Production (Azure) sets these as App Service environment variables instead.

# PostgreSQL in Docker (docker compose up db)
POSTGRES_DB=chartit
POSTGRES_USER=chartit
POSTGRES_PASSWORD=chartit

# Django connection to the database. From the venv the database is on localhost;
# inside Docker, docker-compose.yml overrides the host to "db".
# On Azure: postgres://<user>:<password>@<server>.postgres.database.azure.com:5432/<db>?sslmode=require
DATABASE_URL=postgres://chartit:chartit@localhost:5432/chartit

# PostgreSQL sslmode when DATABASE_URL cannot carry ?sslmode itself. Not needed locally.
# On Render: require (set in render.yaml)
# DATABASE_SSLMODE=require

# Required. Any long random string locally; production uses its own secret key, generated with:
# python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=change-me-local-development-only

# Defaults to False when not set. True only for local development.
DJANGO_DEBUG=True

# Comma-separated host names Django answers to. On Azure: <app>.azurewebsites.net
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated origins (with scheme) trusted for CSRF. Empty locally.
# On Azure: https://<app>.azurewebsites.net
DJANGO_CSRF_TRUSTED_ORIGINS=

# HTTPS redirect, secure cookies and HSTS. Defaults to the opposite of DJANGO_DEBUG,
# so it is on in production without being set.
# DJANGO_HTTPS=False

# HSTS duration in seconds while HTTPS is on (default 3600). Raise to 31536000 once stable.
# DJANGO_HSTS_SECONDS=3600

# Folder for uploaded files (vessel photos). Defaults to backend/media, which is not committed.
# On Azure: /home/media (kept across restarts and deploys)
# DJANGO_MEDIA_ROOT=/home/media

# Login as a test user without OAuth (README, "Testna prijava"). Local development only,
# never on the public instance. Restart the backend and the Vite dev server after changing.
ENABLE_TEST_LOGIN=True
VITE_ENABLE_TEST_LOGIN=True

# Address of the React app. After a failed Google login Django sends the user back here
# (/prijava?greska=...). Locally the app runs on Vite (5173) while Django runs on 8000.
# Leave empty on Render and Azure (frontend and backend share one origin).
FRONTEND_URL=

# Google OAuth client "ChartIt Web Client (lokalno)" (localhost callback only).
# Ask the team for the values; the production client is used only on Render.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
